# Store as /etc/callsec/app.env on the production server, owned by root (0600).
# Use docker compose --env-file /etc/callsec/app.env with this file.
# Generate independent random hex values for all internal secrets.
# POSTGRES_PASSWORD must use URL-safe characters because it forms DATABASE_URL.
