[Unit]
Description=Check and recover Callsec SIP connections
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/node /usr/local/lib/callsec/deploy/asterisk/sip-health.cjs
UMask=0077
TimeoutStartSec=50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/callsec-sip-health /run/callsec-sip-sync /var/lib/callsec-sip-health
RuntimeDirectory=callsec-sip-health
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=callsec-sip-health
StateDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_SYS_PTRACE
UnsetEnvironment=NODE_OPTIONS NODE_PATH CALLSEC_SIP_HEALTH_LOCKED CALLSEC_SIP_HEALTH_RECOVERING
